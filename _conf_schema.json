{
  "backend": {
    "description": "ComfyUI 后端",
    "type": "object",
    "items": {
      "urls": {
        "description": "后端地址列表",
        "type": "list",
        "default": ["http://127.0.0.1:8188"],
        "hint": "每行一个，如 http://127.0.0.1:8188。配置多个后端时会自动选择队列最短的一个，-con 参数可并发使用多个后端。"
      },
      "timeout": {
        "description": "后端探测超时（秒）",
        "type": "int",
        "default": 5
      },
      "task_timeout": {
        "description": "单个任务最长等待时间（秒）",
        "type": "int",
        "default": 1800
      },
      "http_proxy": {
        "description": "HTTP 代理",
        "type": "string",
        "default": "",
        "hint": "留空不使用代理。"
      },
      "model": {
        "description": "默认模型（checkpoint 文件名）",
        "type": "string",
        "default": "",
        "hint": "留空则使用工作流文件里的模型。"
      }
    }
  },
  "workflow": {
    "description": "工作流",
    "type": "object",
    "items": {
      "workflows_dir": {
        "description": "工作流目录",
        "type": "string",
        "default": "",
        "hint": "存放 <名称>.json 与 <名称>_reflex.json 的目录。留空则使用插件数据目录 data/plugin_data/astrbot_plugin_yet_anohter_comfyui/workflows，首次启动会把内置工作流复制进去。"
      },
      "default_workflow": {
        "description": "默认工作流",
        "type": "string",
        "default": "txt2img"
      },
      "trigger_words": {
        "description": "额外触发词",
        "type": "list",
        "default": ["comfyui执行"],
        "hint": "除 prompt 之外，还能触发默认工作流的命令词。每个工作流 reflex 文件里的 command 也会自动注册为命令。"
      },
      "auto_lora": {
        "description": "自动匹配 LoRA",
        "type": "bool",
        "default": false,
        "hint": "开启后，提示词里 <lora:名称:权重> 的名称会和后端已有的 LoRA 文件名模糊匹配。"
      }
    }
  },
  "generation": {
    "description": "生成参数",
    "type": "object",
    "items": {
      "base_res": {
        "description": "基准分辨率",
        "type": "int",
        "default": 1024,
        "hint": "使用 -ar 宽:高 时，总像素量等于该值的平方。"
      },
      "shape_preset": {
        "description": "分辨率预设",
        "type": "list",
        "default": ["p=832x1216", "l=1216x832", "s=1024x1024", "lp=1152x1536", "ll=1536x1152", "ls=1240x1240", "up=960x1920", "ul=1920x960"],
        "hint": "格式 名称=宽x高，通过 -r 名称 使用。"
      },
      "defaults": {
        "description": "默认值",
        "type": "object",
        "items": {
          "width": {"description": "宽度", "type": "int", "default": 832},
          "height": {"description": "高度", "type": "int", "default": 1216},
          "shape": {"description": "默认分辨率预设", "type": "string", "default": "", "hint": "留空按宽高。"},
          "accept_ratio": {"description": "默认画幅比例", "type": "string", "default": "", "hint": "如 16:9，留空按宽高。"},
          "steps": {"description": "步数", "type": "int", "default": 28},
          "cfg_scale": {"description": "CFG scale", "type": "float", "default": 7.0},
          "denoise_strength": {"description": "去噪强度", "type": "float", "default": 1.0},
          "sampler": {"description": "采样器", "type": "string", "default": "dpmpp_2m"},
          "scheduler": {"description": "调度器", "type": "string", "default": "karras"},
          "batch_size": {"description": "每批数量", "type": "int", "default": 1},
          "batch_count": {"description": "批数", "type": "int", "default": 1},
          "preset_prompt": {"description": "预设正面提示词", "type": "text", "default": "", "hint": "会拼在用户提示词前面，-o 可跳过。"},
          "preset_negative_prompt": {"description": "预设负面提示词", "type": "text", "default": "", "hint": "-on 可跳过。"},
          "override": {"description": "默认不使用预设正面提示词", "type": "bool", "default": false},
          "override_ng": {"description": "默认不使用预设负面提示词", "type": "bool", "default": false}
        }
      },
      "max_values": {
        "description": "普通用户上限",
        "type": "object",
        "hint": "管理员与超级用户不受限制。",
        "items": {
          "batch_size": {"description": "每批数量上限", "type": "int", "default": 2},
          "batch_count": {"description": "批数上限", "type": "int", "default": 2},
          "width": {"description": "宽度上限", "type": "int", "default": 2048},
          "height": {"description": "高度上限", "type": "int", "default": 2048},
          "steps": {"description": "步数上限", "type": "int", "default": 100}
        }
      }
    }
  },
  "limits": {
    "description": "频率限制",
    "type": "object",
    "items": {
      "cd": {
        "description": "冷却时间（秒）",
        "type": "int",
        "default": 20,
        "hint": "0 为不限制。"
      },
      "day_limit": {
        "description": "每人每日张数上限",
        "type": "int",
        "default": 50
      },
      "superusers": {
        "description": "超级用户",
        "type": "list",
        "default": [],
        "hint": "不受冷却、每日上限和参数上限约束的用户 ID。AstrBot 管理员自动视为超级用户。"
      }
    }
  },
  "delivery": {
    "description": "消息与保存",
    "type": "object",
    "items": {
      "save_image": {
        "description": "保存生成的图片",
        "type": "bool",
        "default": true,
        "hint": "保存到插件数据目录 output/image/日期/用户ID/。"
      },
      "silent": {
        "description": "静默模式",
        "type": "bool",
        "default": false,
        "hint": "不发送“正在生成中”等提示。"
      },
      "quiet": {
        "description": "安静模式",
        "type": "bool",
        "default": false,
        "hint": "与静默模式相同，但用户无法用参数打开提示。"
      },
      "img_send": {
        "description": "图片发送方式",
        "type": "int",
        "default": 1,
        "hint": "1 直接发图片；2 发图片链接的二维码；3 发图片链接。2 和 3 只在 QQ（aiocqhttp）上可用，其他平台按 1 处理。"
      },
      "r18_action": {
        "description": "违规图片处理方式",
        "type": "int",
        "default": 1,
        "hint": "审核判定违规的图片：1 私聊发给用户；2 群里发二维码；3 群里发链接；其他值直接拦截。2 和 3 只在 QQ 上可用，其他平台拦截。"
      },
      "cards": {
        "description": "用图片卡片显示帮助等信息",
        "type": "bool",
        "default": true,
        "hint": "帮助、工作流列表和后端状态通过 AstrBot 的文转图服务渲染成图片；关闭或渲染失败时发送文字。"
      }
    }
  },
  "audit": {
    "description": "图片审核",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用图片审核",
        "type": "bool",
        "default": true
      },
      "level": {
        "description": "审核等级",
        "type": "int",
        "default": 2,
        "hint": "0 关闭；1 只拦截 explicit；2 再拦截 questionable；3 再拦截 sensitive；100 及以上全部拦截。"
      },
      "mode": {
        "description": "审核方式",
        "type": "string",
        "default": "remote",
        "options": ["remote", "wd14", "nudenet", "dual"],
        "labels": ["远程 tagger API", "本地 WD14", "本地 NudeNet", "WD14 + NudeNet"],
        "hint": "本地方式需要管理员自行安装依赖：WD14 需要 onnxruntime、pandas、huggingface_hub；NudeNet 需要 nudenet。"
      },
      "site": {
        "description": "远程审核地址",
        "type": "string",
        "default": "http://server.20020026.xyz:7865",
        "hint": "sd-webui tagger API 地址，remote 模式使用。"
      },
      "fail_closed": {
        "description": "审核失败时按违规处理",
        "type": "bool",
        "default": true,
        "hint": "审核服务不可用或出错时，开启则按违规处理，关闭则按安全处理。"
      },
      "downscale": {
        "description": "审核前缩小图片",
        "type": "bool",
        "default": false,
        "hint": "缩小到约 640×640 像素再审核，更快。"
      },
      "gpu": {
        "description": "WD14 使用 GPU",
        "type": "bool",
        "default": false
      },
      "wd_repo_id": {
        "description": "WD14 模型仓库",
        "type": "string",
        "default": "wd-vit-tagger-v3"
      },
      "nude_model_path": {
        "description": "NudeNet 模型路径",
        "type": "string",
        "default": "",
        "hint": "留空使用 NudeNet 自带模型。"
      }
    }
  },
  "text_audit": {
    "description": "提示词审核",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用提示词审核",
        "type": "bool",
        "default": false,
        "hint": "用大模型检查提示词，违规则拦截。群设置里可以单独开启拦截或改写。"
      },
      "ban_words": {
        "description": "额外违禁词",
        "type": "list",
        "default": [],
        "hint": "写进审核提示里的额外话题。"
      },
      "provider": {
        "description": "审核使用的模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话正在使用的模型。"
      },
      "use_endpoint": {
        "description": "改用自定义接口",
        "type": "bool",
        "default": false,
        "hint": "开启后不使用 AstrBot 的模型，而是调用下面的 OpenAI 兼容接口。"
      },
      "endpoint": {
        "description": "自定义接口地址",
        "type": "string",
        "default": "https://api.openai.com/v1"
      },
      "token": {
        "description": "自定义接口密钥",
        "type": "string",
        "default": ""
      },
      "model": {
        "description": "自定义接口模型",
        "type": "string",
        "default": "gpt-4o-mini"
      }
    }
  },
  "groups": {
    "description": "群设置",
    "type": "object",
    "items": {
      "overrides": {
        "description": "按群覆盖",
        "type": "template_list",
        "default": [],
        "hint": "为单个群单独设置。数值填 -1 表示跟随全局设置。",
        "templates": {
          "group": {
            "name": "群",
            "hint": "一个群的设置",
            "display_item": "group_id",
            "items": {
              "group_id": {"description": "群号", "type": "string", "default": ""},
              "enabled": {"description": "在本群启用生图", "type": "bool", "default": true},
              "audit_level": {"description": "图片审核等级", "type": "int", "default": -1, "hint": "-1 跟随全局；0 关闭；1-3 同全局说明。"},
              "reject_nsfw_prompts": {"description": "提示词审核", "type": "int", "default": -1, "hint": "-1 跟随全局；0 关闭；1 拦截违规提示词；2 让模型改写提示词。"},
              "img_send": {"description": "图片发送方式", "type": "int", "default": -1, "hint": "-1 跟随全局；1 图片；2 二维码；3 链接。"},
              "pure": {"description": "纯净模式", "type": "bool", "default": false, "hint": "只发结果，不发耗时、任务 ID 等信息。"}
            }
          }
        }
      }
    }
  },
  "llm": {
    "description": "LLM 提示词",
    "type": "object",
    "items": {
      "provider": {
        "description": "llm-tag 使用的模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空则使用当前会话正在使用的模型。"
      },
      "system_prompt": {
        "description": "系统提示词",
        "type": "text",
        "default": "",
        "hint": "留空使用内置的英文提示词生成规则。"
      },
      "presets": {
        "description": "预设",
        "type": "template_list",
        "default": [],
        "hint": "llm-tag -llm N 使用第 N 个预设；-llm 0 或没有对应预设时使用上面的默认设置。",
        "templates": {
          "preset": {
            "name": "预设",
            "display_item": "name",
            "items": {
              "name": {"description": "名称", "type": "string", "default": ""},
              "provider": {"description": "模型", "type": "string", "default": "", "_special": "select_provider", "hint": "留空则使用上面的模型。"},
              "system_prompt": {"description": "系统提示词", "type": "text", "default": "", "hint": "留空则使用上面的系统提示词。"}
            }
          }
        }
      }
    }
  },
  "misc": {
    "description": "其他",
    "type": "object",
    "items": {
      "update_check": {
        "description": "启动时检查更新",
        "type": "bool",
        "default": true,
        "hint": "从 GitHub Releases 检查新版本，有新版本时记录日志并显示在帮助里。"
      }
    }
  }
}
